# Deepseek 在线模型 API 的配置
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 视觉模型配置，用来处理图片的解析
VISION_API_KEY=your_vision_api_key
VISION_BASE_URL=https://ai.devtool.tech/proxy/v1
VISION_MODEL=gpt-4o

# 通过 Ollama 本地部署的模型
OLLAMA_BASE_URL=http://localhost:11434  # 注意：这里需要根据实际情况修改

OLLAMA_CHAT_MODEL=qwen2.5:32b   # 聊天模型
OLLAMA_REASON_MODEL=deepseek-r1:32b  # 推理模型
OLLAMA_AGENT_MODEL=qwen2.5:32b  # Agent模型
OLLAMA_EMBEDDING_MODEL=bge-m3  # 词向量模型

# 模型服务选择
CHAT_SERVICE=deepseek  # 或 ollama， 选择哪个模型服务，就会加载对应哪个模型的 API Key，Base URL，Model 等配置
REASON_SERVICE=ollama  # 或 deepseek，如果选择 Deepseek 模型服务，则需要将 DEEPSEEK_MODEL 设置为 deepseek-reason
AGENT_SERVICE=deepseek  # 或 ollama    

# SerpAPI配置, 联网搜索的 API，注册地址：https://serpapi.com/
SERPAPI_ENABLED=true  # 日常调试快没额度时可设为 false，保留 key 但不注册 SerpAPI provider
SERPAPI_LIVE_ENABLED=false  # 默认只读缓存；关键回归时再打开 live，或设置 PROVIDER_COST_MODE=full
SERPAPI_RESPONSE_CACHE_ENABLED=true  # 开启后同参数 SerpAPI 响应会本地回放，减少重复调试扣费
SERPAPI_RESPONSE_CACHE_DIR=reports/provider-cache/serpapi
SERPAPI_KEY=your-serpapi-key
SEARCH_RESULT_COUNT=10   # 联网搜索结果的数量
PROVIDER_COST_MODE=standard  # cheap / standard / full；cheap 会跳过 SerpAPI，保留 Amap/Geoapify/Mock

# Geoapify 配置，低成本全球 geocoding / places Provider，适合海外 POI 日常调试
GEOAPIFY_ENABLED=true
GEOAPIFY_LIVE_ENABLED=true
GEOAPIFY_RESPONSE_CACHE_ENABLED=true
GEOAPIFY_RESPONSE_CACHE_DIR=reports/provider-cache/geoapify
GEOAPIFY_DAILY_LIVE_LIMIT=500  # 每日 Geoapify live 调用软上限；0 表示不限制
GEOAPIFY_RATE_LIMIT_COOLDOWN_SECONDS=86400  # 收到 429 后暂停 live 的秒数
GEOAPIFY_BUDGET_STATE_DIR=reports/provider-budget
GEOAPIFY_KEY=your-geoapify-key

# 高德地图 POI Provider 开关
AMAP_ENABLED=true
AMAP_API_KEY=your-amap-api-key

# 仅供离线测试使用；生产发布门禁不允许 Mock POI 充当真实候选
ALLOW_MOCK_PUBLISH=false

# Hybrid Structured QP：默认关闭。shadow 只记录 DeepSeek 结果，不改变路由；
# selective 仅在上下文编辑、英文城市缺失等高风险输入上调用 Structured QP。
# ENABLE_STRUCTURED_QP=true 保留旧配置兼容，等价于 STRUCTURED_QP_MODE=selective。
ENABLE_STRUCTURED_QP=false
STRUCTURED_QP_MODE=off  # off / shadow / selective
STRUCTURED_QP_TIMEOUT_SECONDS=4.0
STRUCTURED_QP_CONFIDENCE_THRESHOLD=0.65

# 本地Mysql数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=travelmind

# 本地Neo4j数据库配置
NEO4J_URL=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j

# 本地Redis缓存配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_CACHE_EXPIRE=3600
REDIS_CACHE_THRESHOLD=0.90  # 缓存阈值

# Microsoft GraphRAG 配置
GRAPHRAG_PROJECT_DIR=  # GraphRAG项目目录
GRAPHRAG_DATA_DIR=data                         # 数据目录名称
GRAPHRAG_QUERY_TYPE=local                      # 查询类型: local, global, drift, basic
GRAPHRAG_RESPONSE_TYPE=text                    # 响应类型: text
GRAPHRAG_COMMUNITY_LEVEL=3                     # 社区级别
GRAPHRAG_DYNAMIC_COMMUNITY=false               # 是否动态选择社区
